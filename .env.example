# ============================================================
# .env.example - 环境变量配置模板
# 使用说明：复制此文件为 .env，填入你的真实值
# ⚠️ .env 文件已加入 .gitignore，不会被提交到 Git
# ============================================================

# ---------- LLM API 配置 ----------
# 大模型服务的基础 URL（如 OpenAI、Dify、Coze 等）
LLM_BASE_URL=https://api.openai.com/v1

# LLM API 密钥
LLM_API_KEY=sk-your-llm-api-key-here

# ---------- 飞书推送配置 ----------
# 飞书自定义机器人 Webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-key-here

# ---------- GitHub Actions 主节点配置 ----------
# 账户 A 的 LLM API 密钥（可与 LLM_API_KEY 相同）
OPENAI_API_KEY=sk-your-openai-key-here

# 账户 B 的 GitHub Personal Access Token（用于触发远程工作流）
# 生成方式：GitHub → Settings → Developer settings → Personal access tokens
GH_PAT_ACCOUNT_B=ghp_your_pat_account_b_here

# 账户 C 的 GitHub Personal Access Token
GH_PAT_ACCOUNT_C=ghp_your_pat_account_c_here

# 飞书 Webhook（主节点也用同一个）
FEISHU_WEBHOOK_MAIN=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-key-here

# ---------- 从节点配置 ----------
# 账户 B 的飞书 Webhook（可选，与主 Webhook 不同时可单独设置）
FEISHU_WEBHOOK_B=

# 账户 C 的飞书 Webhook（可选）
FEISHU_WEBHOOK_C=

# ---------- AlphaSift 本地项目路径（可选）----------
# 如果本地有 AlphaSift 真实项目，填写其路径
ALPHASIFT_PROJECT_PATH=C:\Users\zf\Documents\github项目\alphasift
